# Django Core Settings
SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=*

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=nepcart <your_email@gmail.com>

# Khalti Payment Gateway (Sandbox / Test Environment)
KHALTI_SECRET_KEY=your_khalti_test_secret_key
KHALTI_BASE_URL=https://dev.khalti.com/api/v2/epayment/
